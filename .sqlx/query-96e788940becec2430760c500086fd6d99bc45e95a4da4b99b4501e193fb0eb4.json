  "query": "\n        SELECT\n            id::text AS \"id!\",\n            title AS \"title!\",\n            year,\n            status,\n            total_episode_count AS episode_count\n        FROM tv_shows\n        WHERE title ILIKE $1\n        ORDER BY title\n        LIMIT 20\n        ",
