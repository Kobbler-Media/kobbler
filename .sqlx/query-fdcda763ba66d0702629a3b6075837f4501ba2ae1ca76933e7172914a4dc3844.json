  "query": "\n        SELECT id, channel_id, title, description, start_time, stop_time,\n               categories, episode_info, created_at\n        FROM iptv_epg\n        WHERE channel_id = $1 AND start_time < $3 AND stop_time > $2\n        ORDER BY start_time ASC\n        ",
