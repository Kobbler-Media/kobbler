  "query": "\n        SELECT mc.person_id, p.name AS person_name, mc.department, mc.job\n        FROM movie_crew mc\n        JOIN people p ON p.id = mc.person_id\n        WHERE mc.movie_id = $1\n        ORDER BY mc.department ASC, mc.job ASC\n        ",
