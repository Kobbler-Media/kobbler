  "query": "\n            SELECT sh.title AS \"show!\", se.season_identifier AS \"season!\",\n                   ep.episode_identifier AS \"episode!\", ep.title AS \"title?\"\n            FROM tv_episodes ep\n            JOIN tv_seasons se ON se.id = ep.season_id\n            JOIN tv_shows sh ON sh.id = se.show_id\n            WHERE ep.id = $1\n            ",
