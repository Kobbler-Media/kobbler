  "query": "\n        SELECT e.id, e.channel_id, e.title, e.start_time, e.stop_time, c.name AS channel\n        FROM iptv_epg e\n        JOIN iptv_channels c ON c.id = e.channel_id\n        WHERE e.id = $1\n        ",
