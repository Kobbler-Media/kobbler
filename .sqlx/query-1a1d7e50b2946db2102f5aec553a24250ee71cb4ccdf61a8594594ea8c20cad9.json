  "query": "\n        SELECT kd.id, kd.kindle_target_id, kt.device_name, kd.delivered_at\n        FROM kindle_deliveries kd\n        JOIN kindle_targets kt ON kt.id = kd.kindle_target_id\n        WHERE kd.book_id = $1\n        ORDER BY kd.delivered_at DESC\n        ",
