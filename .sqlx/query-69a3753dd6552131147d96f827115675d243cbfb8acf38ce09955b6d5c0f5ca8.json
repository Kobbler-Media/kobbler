  "query": "\n        SELECT s.title AS \"show_title!\",\n               ts.season_identifier,\n               ts.title AS \"season_title?\",\n               (ts.images->>'poster') AS \"poster_url?\"\n        FROM tv_seasons ts\n        JOIN tv_shows s ON s.id = ts.show_id\n        WHERE ts.id = $1\n        ",
