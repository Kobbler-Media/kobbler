  "query": "\n        SELECT file_path, file_size\n        FROM debrid_cache_files\n        WHERE info_hash = $1\n          AND file_id IS NOT DISTINCT FROM $2\n          AND (debrid_provider_id IS NULL OR debrid_provider_id = $3)\n        ORDER BY last_accessed_at DESC\n        LIMIT 1\n        ",
