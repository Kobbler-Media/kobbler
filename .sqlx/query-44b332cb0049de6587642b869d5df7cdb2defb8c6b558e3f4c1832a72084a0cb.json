{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            b.title,\n            b.narrator,\n            (\n                SELECT a.name\n                FROM book_authors ba\n                JOIN authors a ON a.id = ba.author_id\n                WHERE ba.book_id = b.id\n                ORDER BY a.name ASC\n                LIMIT 1\n            ) AS author\n        FROM books b\n        WHERE b.id = $1\n        ",
