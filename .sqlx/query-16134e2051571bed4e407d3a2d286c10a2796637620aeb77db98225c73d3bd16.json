  "query": "\n        SELECT (watched_secs::float8 / programme_secs::float8) AS \"completion!\",\n               started_at\n        FROM livetv_watch_events\n        WHERE user_id = $1 AND series_id = $2\n          AND programme_secs IS NOT NULL AND programme_secs > 0\n        ORDER BY started_at DESC\n        LIMIT $3\n        ",
