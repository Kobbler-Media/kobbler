{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT b.title,\n               string_agg(a.name, ', ' ORDER BY a.name) AS \"authors?\",\n               (b.images != '{}'::jsonb) AS \"has_image!\"\n        FROM books b\n        LEFT JOIN book_authors ba ON ba.book_id = b.id\n        LEFT JOIN authors a ON a.id = ba.author_id\n        WHERE b.id = $1\n        GROUP BY b.id, b.title\n        ",
