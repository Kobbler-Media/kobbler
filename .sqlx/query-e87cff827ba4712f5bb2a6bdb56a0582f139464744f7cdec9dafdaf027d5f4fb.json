  "query": "\n        SELECT bs.series_id, s.name AS series_name, bs.series_index\n        FROM book_series bs\n        JOIN series s ON s.id = bs.series_id\n        WHERE bs.book_id = $1 AND bs.is_primary = TRUE\n        ",
