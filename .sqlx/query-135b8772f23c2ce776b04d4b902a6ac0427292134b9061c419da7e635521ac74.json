  "query": "\n        DELETE FROM search_embeddings e\n        WHERE NOT EXISTS (\n            SELECT 1 FROM search_embedding_sources s\n            WHERE s.entity_type = e.entity_type AND s.entity_id = e.entity_id\n              AND s.kind = e.kind\n        )\n        RETURNING e.entity_type, e.entity_id\n        ",
