  "query": "\n        SELECT DISTINCT af.book_id, b.title\n        FROM audiobook_files af\n        JOIN books b ON b.id = af.book_id\n        WHERE EXISTS (\n            SELECT 1 FROM audiobook_chapters ac\n            WHERE ac.audiobook_file_id = af.id AND ac.source = 'detected'\n        )\n        ",
