  "query": "\n        SELECT DISTINCT bf.book_id, b.title\n        FROM book_files bf\n        JOIN books b ON b.id = bf.book_id\n        WHERE NOT EXISTS (\n            SELECT 1 FROM ebook_segments es\n            WHERE es.book_file_id = bf.id\n        )\n        ",
