{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            s.id AS season_id,\n            s.season_identifier,\n            sh.id AS show_id,\n            sh.title AS show_title,\n            CASE WHEN (sh.images->'poster'->>'source_url' IS NOT NULL OR sh.images->'poster'->>'cached_at' IS NOT NULL)\n                 THEN '/api/v1/admin/tv/shows/' || sh.id || '/poster'\n                 ELSE NULL\n            END as poster_url\n        FROM tv_seasons s\n        JOIN tv_shows sh ON sh.id = s.show_id\n        WHERE s.id = ANY($1)\n        ",
