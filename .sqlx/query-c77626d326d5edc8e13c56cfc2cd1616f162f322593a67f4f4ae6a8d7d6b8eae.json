  "query": "\n            SELECT e.title, e.air_date\n            FROM tv_episodes e\n            JOIN tv_seasons s ON s.id = e.season_id\n            WHERE s.show_id = $1\n              AND s.season_identifier = $2\n              AND e.episode_identifier = $3\n            ",
