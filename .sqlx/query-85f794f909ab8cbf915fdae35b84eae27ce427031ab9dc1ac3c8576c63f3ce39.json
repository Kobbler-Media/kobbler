{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT bs.series_id, s.name AS series_name,\n               bs.series_index, bs.is_primary AS \"is_primary!\",\n               s.total_book_count\n        FROM book_series bs\n        JOIN series s ON s.id = bs.series_id\n        WHERE bs.book_id = $1\n        ORDER BY bs.is_primary DESC, s.total_book_count ASC NULLS LAST, s.name\n        ",
