  "query": "\n        SELECT p.id AS \"person_id!\", p.name AS \"name!\", mcr.job\n        FROM movie_crew mcr\n        JOIN people p ON p.id = mcr.person_id\n        WHERE mcr.movie_id = $1 AND mcr.job = 'Director'\n        ORDER BY p.name ASC, p.id ASC\n        ",
