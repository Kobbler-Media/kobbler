  "query": "\n        SELECT rs.id AS state_id, rb.location_value AS \"location_value!\"\n        FROM reading_states rs\n        JOIN reading_bookmark rb ON rb.reading_state_id = rs.id\n        WHERE rs.book_id = $1\n          AND rb.location_type = 'audiobook'\n          AND rb.location_value IS NOT NULL\n        ",
