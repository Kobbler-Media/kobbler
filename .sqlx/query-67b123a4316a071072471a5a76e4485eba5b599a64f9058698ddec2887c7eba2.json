  "query": "\n        SELECT ts.id, ts.season_identifier, ts.season_sort_order, ts.title,\n               ts.is_special, ts.episode_count\n        FROM tv_seasons ts\n        WHERE ts.show_id = $1 AND ts.season_sort_order = $2\n        ORDER BY ts.season_identifier ASC, ts.id ASC\n        LIMIT 1\n        ",
