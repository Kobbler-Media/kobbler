  "query": "\n        SELECT r.id, r.status, r.output_dir\n        FROM livetv_recordings r\n        JOIN livetv_channels c ON c.id = r.channel_id\n        WHERE c.tuner_id = $1\n        ORDER BY r.scheduled_start\n        ",
