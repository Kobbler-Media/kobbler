  "db_name": "PostgreSQL",
  "query": "\n        SELECT e.id, e.book_file_id, e.segment_index, e.cfi, e.text, e.chapter_title, e.created_at\n        FROM ebook_segments e\n        JOIN book_files bf ON bf.id = e.book_file_id\n        WHERE bf.book_id = $1\n        ORDER BY e.segment_index\n        ",
