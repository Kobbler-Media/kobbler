  "query": "\n        SELECT id, transport, target, message_id, entity_kind, entity_id, label,\n               user_id, last_state, created_at, expires_at\n        FROM chat_watches\n        WHERE entity_id = ANY($1) AND expires_at > NOW()\n        ORDER BY created_at, id\n        ",
