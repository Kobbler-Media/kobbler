  "query": "\n        SELECT id, file_path, format FROM book_files\n        WHERE book_id = $1 AND available = TRUE AND format != ALL($2)\n        ORDER BY CASE format WHEN 'EPUB' THEN 1 ELSE 2 END\n        LIMIT 1\n        ",
