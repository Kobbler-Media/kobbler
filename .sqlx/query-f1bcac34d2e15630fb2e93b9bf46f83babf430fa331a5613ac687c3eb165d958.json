  "query": "\n        SELECT id, user_id, title, message, entity_type, entity_id, entity_url, read, created_at\n        FROM user_notifications\n        WHERE user_id = $1 AND ($4 = false OR read = false)\n        ORDER BY created_at DESC\n        LIMIT $2 OFFSET $3\n        ",
