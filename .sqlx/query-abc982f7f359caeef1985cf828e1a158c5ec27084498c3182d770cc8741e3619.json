  "query": "\n        SELECT id, transport, address, external_id, user_id, max_role, enabled,\n               created_at, last_seen_at\n        FROM chat_identities\n        WHERE enabled = TRUE AND user_id = ANY($1)\n        ORDER BY user_id, created_at\n        ",
