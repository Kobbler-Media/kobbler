  "query": "\n            SELECT id, event_kind, entity_type, entity_id, title, subtitle, image_url, url, created_at\n            FROM activity_log\n            WHERE (created_at, id) < ($1, $2)\n            ORDER BY created_at DESC, id DESC\n            LIMIT $3\n            ",
