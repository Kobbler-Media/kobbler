  "query": "\n        SELECT id, name\n        FROM iptv_channels\n        WHERE enabled\n          AND (name ILIKE $1 OR normalized_name ILIKE $1)\n        ORDER BY (LOWER(name) = LOWER($2)) DESC,\n                 LENGTH(name) ASC,\n                 display_order ASC,\n                 name ASC,\n                 id ASC\n        LIMIT $3\n        ",
