  "query": "SELECT t.user_id, u.role, u.is_kids\n        FROM auth_tokens t\n        JOIN users u ON u.id = t.user_id\n        WHERE t.token_hash = $1 AND t.revoked = FALSE AND t.scope = 'admin' AND t.expires_at > NOW()",
