  "db_name": "PostgreSQL",
  "query": "\n        SELECT b.title, b.description, b.language, b.publisher, b.pubdate,\n               bs.series_id AS \"series_id?\", bs.series_index AS \"series_index?\"\n        FROM books b\n        LEFT JOIN book_series bs ON bs.book_id = b.id AND bs.is_primary = TRUE\n        WHERE b.id = $1\n        ",
