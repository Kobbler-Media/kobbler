{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            c.id,\n            c.audiobook_file_id,\n            af.file_path,\n            af.duration_seconds AS file_duration_seconds,\n            c.chapter_index,\n            c.title,\n            c.start_seconds,\n            c.end_seconds,\n            c.source\n        FROM audiobook_chapters c\n        JOIN audiobook_files af ON af.id = c.audiobook_file_id\n        WHERE af.book_id = $1\n        ORDER BY af.file_index, af.file_path, c.chapter_index\n        ",
