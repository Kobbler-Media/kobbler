  "query": "\n        INSERT INTO debrid_files (cache_path, media_type, media_id)\n        VALUES ($1, $2, $3)\n        ON CONFLICT (cache_path) DO UPDATE\n            SET media_type = EXCLUDED.media_type, media_id = EXCLUDED.media_id\n        RETURNING id, cache_path, media_type, media_id\n        ",
