  "query": "\n        SELECT id, title,\n            CASE WHEN (images->'poster'->>'source_url' IS NOT NULL OR images->'poster'->>'cached_at' IS NOT NULL)\n                 THEN '/api/v1/admin/tv/shows/' || id || '/poster'\n                 ELSE NULL\n            END as poster_url\n        FROM tv_shows\n        WHERE id = ANY($1)\n        ",
