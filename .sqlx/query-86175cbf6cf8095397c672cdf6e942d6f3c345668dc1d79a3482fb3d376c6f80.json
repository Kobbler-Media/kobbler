  "query": "\n        SELECT te.id\n        FROM tv_episodes te\n        JOIN tv_seasons ts ON ts.id = te.season_id\n        WHERE ts.show_id = $1\n          AND regexp_replace(lower(COALESCE(te.title, '')), '[^a-z0-9]+', '', 'g') = $2\n        ",
