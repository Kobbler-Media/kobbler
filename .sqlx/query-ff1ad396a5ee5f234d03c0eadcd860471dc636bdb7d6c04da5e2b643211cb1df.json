{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, file_path, format FROM book_files\n        WHERE book_id = $1 AND available = TRUE\n        ORDER BY CASE format\n            WHEN 'MOBI' THEN 1\n            WHEN 'AZW3' THEN 2\n            WHEN 'AZW' THEN 3\n            WHEN 'EPUB' THEN 4\n            WHEN 'KEPUB' THEN 5\n            ELSE 6\n        END\n        LIMIT 1\n        ",
