  "query": "\n        SELECT DISTINCT b.id, b.title\n        FROM books b\n        JOIN entitlements e ON e.book_id = b.id\n        WHERE e.scope_type = 'DEVICE' AND e.scope_id = $1 AND e.is_removed = FALSE\n        ORDER BY b.title\n        ",
