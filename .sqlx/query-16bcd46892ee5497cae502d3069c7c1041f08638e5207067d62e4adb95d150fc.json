  "query": "\n        SELECT p.id AS \"person_id!\", p.name AS \"name!\", tcr.job\n        FROM tv_crew tcr\n        JOIN people p ON p.id = tcr.person_id\n        WHERE tcr.show_id = $1 AND tcr.job IN ('Creator', 'Director')\n        ORDER BY tcr.job ASC, p.name ASC, p.id ASC\n        ",
