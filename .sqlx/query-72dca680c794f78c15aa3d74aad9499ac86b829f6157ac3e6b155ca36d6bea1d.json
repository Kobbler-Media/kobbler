  "query": "\n        SELECT c.id, c.name\n        FROM iptv_favourites f\n        JOIN iptv_channels c ON c.id = f.channel_id\n        WHERE f.user_id = $1 AND c.enabled\n        ORDER BY f.display_order ASC, c.name ASC, c.id ASC\n        LIMIT $2\n        ",
