  "query": "\n        SELECT DISTINCT b.id, b.title\n        FROM books b\n        JOIN book_files bf ON bf.book_id = b.id\n        WHERE (EXISTS (SELECT 1 FROM book_files bf WHERE bf.book_id = b.id) OR EXISTS (SELECT 1 FROM audiobook_files af WHERE af.book_id = b.id))\n        ",
