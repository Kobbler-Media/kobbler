  "query": "\n        SELECT COALESCE(d.name, 'device') AS \"device_name!\", rs.client_payload\n        FROM reading_states rs\n        JOIN devices d ON d.id = rs.device_id\n        WHERE rs.book_id = $1 AND d.device_type = 'kobo' AND rs.client_payload IS NOT NULL\n        ",
