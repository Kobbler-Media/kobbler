{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT ts.title AS show_title,\n               ts.id AS show_id,\n               ts.content_category,\n               ts.year,\n               s.season_sort_order,\n               (SELECT array_agg(e.episode_sort_order ORDER BY e.episode_sort_order)\n                FROM tv_episodes e WHERE e.season_id = s.id\n               ) AS \"episodes?: Vec<i32>\"\n        FROM tv_seasons s\n        JOIN tv_shows ts ON ts.id = s.show_id\n        WHERE s.id = $1\n        ",
