  "query": "\n        SELECT id, transport, user_id, updated_at\n        FROM chat_sessions\n        WHERE closed_at IS NULL\n          AND updated_at < NOW() - make_interval(mins => $1)\n        ORDER BY updated_at ASC\n        LIMIT $2\n        ",
