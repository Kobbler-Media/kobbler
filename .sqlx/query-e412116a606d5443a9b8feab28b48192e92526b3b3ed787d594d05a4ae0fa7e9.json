{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.id, s.user_id, s.endpoint, s.p256dh, s.auth, s.user_agent, s.created_at\n        FROM webpush_subscriptions s\n        JOIN users u ON u.id = s.user_id\n        WHERE u.role = ANY($1)\n        ORDER BY s.created_at ASC\n        ",
