  "query": "\n        SELECT DISTINCT tef.id, tef.file_path\n        FROM tv_episode_files tef\n        JOIN tv_episode_file_episodes tefe ON tefe.episode_file_id = tef.id\n        JOIN tv_episodes te ON te.id = tefe.episode_id\n        WHERE te.season_id = $1\n        ",
