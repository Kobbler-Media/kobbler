  "query": "\n        SELECT DISTINCT af.book_id, b.title\n        FROM audiobook_files af\n        JOIN books b ON b.id = af.book_id\n        WHERE NOT EXISTS (\n            SELECT 1 FROM audiobook_transcripts at\n            WHERE at.audiobook_file_id = af.id\n        )\n        ",
