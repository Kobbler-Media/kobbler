  "query": "\n        SELECT g.id, g.name, COUNT(bg.book_id) as \"book_count!: i64\"\n        FROM genres g\n        LEFT JOIN book_genres bg ON bg.genre_id = g.id\n        GROUP BY g.id, g.name\n        ORDER BY g.name ASC\n        ",
