  "query": "\n        SELECT id, title,\n            CASE WHEN (images->'poster'->>'source_url' IS NOT NULL OR images->'poster'->>'cached_at' IS NOT NULL)\n                 THEN '/api/v1/admin/movies/' || id || '/poster'\n                 ELSE NULL\n            END as poster_url,\n            year\n        FROM movies\n        WHERE id = ANY($1)\n        ",
