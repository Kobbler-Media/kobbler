# Kobbler environment. Copy to .env and edit; docker compose reads it
# automatically.
#
#   cp .env.example .env

# ─── required secrets ────────────────────────────────────────────────────────
# Generate real values, e.g. `openssl rand -hex 32`.
NATS_TOKEN=changeme
MEILI_MASTER_KEY=changeme
POSTGRES_PASSWORD=kobbler

# ─── core ────────────────────────────────────────────────────────────────────
# First admin account.
ADMIN_EMAIL=admin@localhost

# Timezone used for quiet hours and scheduling when a user has none set.
TZ=UTC

# Where your library lives on the host. Mounted at /media in the api container,
# so library and watch paths configured in the UI are /media/... paths.
KOBBLER_MEDIA_ROOT=./data/media

# Comma-separated extra browser origins allowed to call the API. Empty is fine
# when the bundled web container is the only client.
KOBBLER_WEB_ORIGINS=

# PIN pairing relay for client apps (see docs/pin-login.md). Empty uses the
# public https://pin.biboop.com; point it at your own relay to self-host pairing.
KOBBLER_PIN_SERVICE_URL=

# Path to the koblibs checkout the images build against. Default: ../koblibs.
# KOBLIBS_DIR=../koblibs

# Container registry the api/web images are named for. Only change it if you
# publish your own builds somewhere else.
KOBBLER_REGISTRY=ghcr.io/kobbler-media

# Image tag. `latest` follows main; a release (`0.1`, or exactly `0.1.0`) stays put
# until you change it. Releases: https://github.com/Kobbler-Media/kobbler/releases
KOBBLER_TAG=latest

RUST_LOG=info,api=info,tower_http=info
KOBBLER_HTTP_TRACE=0

# Calibre fallback converters. Empty = look on PATH (they ship in the image).
EBOOK_CONVERT_PATH=
EBOOK_META_PATH=

# ─── ports ───────────────────────────────────────────────────────────────────
KOBBLER_WEB_PORT=5173
KOBBLER_API_PORT=6766
KOBBLER_PROXY_PORT=6767
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# ─── advanced api tuning ─────────────────────────────────────────────────────
# Defaults shown; leave commented unless you need to change one.
# Postgres connection pool size.
# DATABASE_MAX_CONNECTIONS=10
# Largest accepted request body (uploads), in bytes. Default 200 MB.
# HTTP_MAX_BODY_BYTES=209715200
# Max concurrent filesystem-heavy jobs; lower it if a NAS struggles.
# KOBBLER_FS_CONCURRENCY=8
# Max concurrent enrichment jobs (thumbnails, loudness, waveform peaks).
# KOBBLER_ENRICHMENT_CONCURRENCY=4
# Stremio API used by the Stremio integration. Empty = https://api.strem.io.
# KOBBLER_STREMIO_API_URL=
# Show koblem settings in the UI. koblem is experimental and tuned for one
# hardware setup, so they are hidden unless this is 1.
# KOBLEM_UI_ENABLED=0

# ─── external services ───────────────────────────────────────────────────────
# Only set these to point at NATS / Meilisearch instances outside this stack
# (e.g. one shared with kobload).
# NATS_URL=nats://token@nats:4222
# MEILI_URL=http://meilisearch:7700

# ─── GPU overlay (docker-compose.gpu.yml) ────────────────────────────────────
# Only needed if you run:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d

# tts-breeze — text-to-speech. The GGUF has to be converted yourself; see
# docker/tts-breeze/README.md ("Weights").
BREEZE_REPO=https://github.com/dbrain/hbd-qwen3-tts.cpp.git
BREEZE_REF=d022511
# CUDA compute capabilities to build for: 86 = Ampere, 89 = Ada, 120 = Blackwell.
# Trim to just your card to save ~15-20 MiB of idle VRAM per omitted arch. The
# same applies to PARAKEET_CUDA_ARCHS below.
BREEZE_CUDA_ARCHS=86;89;120
# Host directory holding the Breeze GGUF (mounted read-only at /models).
BREEZE_MODELS_DIR=./data/models
BREEZE_MODEL=breeze-tts-2-v2-Q4_K_M.gguf
BREEZE_TEXT_ENC_CPU=1
BREEZE_IDLE_UNLOAD_SECONDS=300
TTS_BREEZE_PORT=8803

# stt-parakeet-cpp — speech-to-text. Downloads its own GGUF on first request.
PARAKEET_REPO=https://github.com/dbrain/hbd-CrispASR.git
PARAKEET_REF=457252dd
PARAKEET_CUDA_ARCHS=86;89;120
PARAKEET_FORCE_MMQ=OFF
PARAKEET_MODEL_QUANT=q8_0
PARAKEET_IDLE_UNLOAD_SECONDS=300
PARAKEET_WORKER_ISOLATION=1
STT_PARAKEET_PORT=8023

# embed-vision / embed-text — EmbeddingGemma-2 on the stock llama.cpp server
# image. The entrypoint downloads the GGUFs from EMBED_HF_REPO on first start.
EMBED_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
EMBED_HF_REPO=unsloth/embeddinggemma-2-GGUF
EMBED_MODEL_FILE=embeddinggemma-2-Q8_0.gguf
EMBED_MMPROJ_FILE=mmproj-Q8_0.gguf
EMBED_VISION_PORT=18894
EMBED_TEXT_PORT=18895

# ─── dev stack (docker-compose.dev.yml) ──────────────────────────────────────
# Host directory of sample media used by the dev containers.
KOBBLER_TEST_DATA=./local/test-data
