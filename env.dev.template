# =============================================================================
# Kobbler Development Environment Configuration
# =============================================================================
# Copy this file to .env.dev to use these settings in dev mode.
# This file is loaded by docker-compose.dev.yml.
#
# To apply changes: docker compose -f docker-compose.dev.yml up -d --build
# =============================================================================

# -----------------------------------------------------------------------------
# Admin Authentication
# -----------------------------------------------------------------------------
# Fixed admin password for dev (avoids needing to extract from logs)
# Default: kob-dev-password (same as Kobload for easier cross-project dev)
DEV_ADMIN_PASSWORD=kob-dev-password

# Admin email (also used as username)
ADMIN_EMAIL=admin@localhost

# -----------------------------------------------------------------------------
# Dev Mode Settings
# -----------------------------------------------------------------------------
# Enable dev mode features (dev tools page, auto-restore)
DEV_MODE=1

# Auto-restore from dev snapshot on startup (if snapshot exists)
# Only restores on fresh database (no users). To reset: docker compose down -v
DEV_AUTO_RESTORE=1

# -----------------------------------------------------------------------------
# Fixed Ingest Token (for Kobload integration)
# -----------------------------------------------------------------------------
# This token is created on startup for cross-project integration
DEV_INGEST_TOKEN=dev-ingest-token-shared

# -----------------------------------------------------------------------------
# Kobload Integration
# -----------------------------------------------------------------------------
# Kobload API URL (uses docker service name on shared network)
KOBLOAD_BASE_URL=http://kobload-api:7080

# Kobload API key (must match KOBLOAD_API_KEY in Kobload's .env.dev)
KOBLOAD_API_KEY=dev-kobload-api-key

# -----------------------------------------------------------------------------
# Metadata Providers
# -----------------------------------------------------------------------------
# Hardcover API key (optional - for book metadata lookups)
# Get one at: https://hardcover.app/account/api
HARDCOVER_API_KEY=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
RUST_LOG=info,api=debug,tower_http=info

# Enable HTTP header tracing (verbose, useful for debugging)
KOBBLER_HTTP_TRACE=0

# -----------------------------------------------------------------------------
# Port Overrides (optional)
# -----------------------------------------------------------------------------
# KOBBLER_API_PORT=6766
# KOBBLER_PROXY_PORT=6767
# KOBBLER_WEB_PORT=5173
