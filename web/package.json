{
  "name": "web",
  "private": true,
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "mkdir -p static/jassub && cp node_modules/jassub/dist/wasm/jassub-worker.js node_modules/jassub/dist/wasm/jassub-worker.wasm node_modules/jassub/dist/default.woff2 static/jassub/ 2>/dev/null || true",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@koblibs/ui": "file:../../koblibs",
    "diff": "^9.0.0",
    "foliate-js": "^1.0.1",
    "highlight.js": "^11.11.1",
    "hls.js": "^1.6.17",
    "isomorphic-dompurify": "^3.22.0",
    "jassub": "^2.5.14",
    "marked": "^18.0.9",
    "svelte-easy-crop": "^5.0.1"
  }
}
